[Unit]
Description=GymRats API (Django + gunicorn)
After=network.target

[Service]
User=jinyoung
Group=gymrats
WorkingDirectory=/srv/gymrats/backend
# Secrets come from here only; the repo has .env.example with placeholders.
EnvironmentFile=/srv/gymrats/.env
ExecStart=/srv/gymrats/backend/.venv/bin/gunicorn gymrats.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 15
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
