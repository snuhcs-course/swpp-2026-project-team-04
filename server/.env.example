# Copy to /srv/gymrats/.env on the server and fill in real values there.
# Never commit the real file.

# Two different random values of 32+ characters. Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Django's own signing key:
DJANGO_SECRET_KEY=change-me
# Signs login tokens:
JWT_SECRET=change-me

# Database URL (dj-database-url format).
DATABASE_URL=sqlite:////srv/gymrats/data/gymrats.db

# How long a login token stays valid, in days.
TOKEN_DAYS=30

# Host names the API answers to, comma separated.
ALLOWED_HOSTS=52.78.38.225,localhost,127.0.0.1
