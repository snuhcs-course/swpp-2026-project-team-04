+        elbow - minArm >= 14;
+    final tilted =
+        config.shallowTiltReasonDegrees > 0 &&
+        (maxTilt ?? 0) > config.shallowTiltReasonDegrees &&
+        minArm <= 140;
+    final event = completed
+        ? RepEvent(
+            index: index,
+            valid: false,
+            at: now,
+            reason: supported
+                ? RejectReason.kneesDown
+                : tilted
+                ? RejectReason.shouldersNotLevel
+                : RejectReason.insufficientDepth,
+            maxDepth: peak,
+            minElbowAngle: minArm,
+            maxTilt: maxTilt,
+          )
+        : null;
+    reset();
+    if (elbow != null && elbow >= config.topAngle) topElbow = elbow;
+    return event;
+  }
+}
